# Chatling.ai — paste the chatbot ID from the official embed snippet in your Chatling dashboard.
# Leave empty to show the placeholder launcher.
NEXT_PUBLIC_CHATLING_CHATBOT_ID=

# Intro video (hosted MP4/WebM URL or YouTube/Vimeo embed URL). Leave empty to show the placeholder.
NEXT_PUBLIC_INTRO_VIDEO_URL=
NEXT_PUBLIC_INTRO_VIDEO_CAPTIONS_URL=

# Form endpoint (Formspree or CRM form URL) — static hosting has no server. Empty = prototype mode.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Analytics (provider TBD). Events are pushed to window.dataLayer.
NEXT_PUBLIC_SITE_URL=https://example.com
